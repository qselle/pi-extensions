{
  "name": "@qselle/pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "A personal collection of extensions for the pi coding agent.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "bun run typecheck && bun test --parallel=2",
    "test": "bun test --parallel=2",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "node scripts/prepare-pty.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:install": "node scripts/check-package.mjs --clean-install",
    "check:linux": "node scripts/check-linux.mjs",
    "preview:ui": "node scripts/preview-ui.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.1 <0.87.0",
    "@earendil-works/pi-coding-agent": ">=0.86.1 <0.87.0",
    "@earendil-works/pi-tui": ">=0.86.1 <0.87.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@types/bun": "^1.3.14",
    "@types/proper-lockfile": "4.1.4",
    "@xterm/headless": "6.0.0",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qselle/pi-extensions.git"
  },
  "pi": {
    "extensions": [
      "./extensions/*"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "dependencies": {
    "marked": "18.0.5",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2"
  },
  "files": [
    "lib/**/*.ts",
    "!lib/**/*.test.ts",
    "!lib/**/*fixture.ts",
    "!lib/**/*benchmark.ts",
    "extensions/**/*.ts",
    "extensions/**/README.md",
    "!extensions/**/*.test.ts",
    "!extensions/**/*fixture.ts",
    "!extensions/**/*benchmark.ts",
    "themes/*.json",
    "scripts/prepare-pty.mjs",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ]
}
